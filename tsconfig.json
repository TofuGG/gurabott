{
	"compilerOptions": {
		"strict": true,
		"module": "NodeNext",
		"target": "ES2020",
		"lib": ["ES2021"],
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/solid",
		"types": ["node"]
	}
}