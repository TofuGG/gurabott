{
  "client": {
    "host": "SERVER_ADDRESS",
    "port": "PORT",
    "username": "USERNAME"
  },
  "ai": {
    "enabled": false,
    "apiKey": "YOUR_GROQ_API",
    "maxTokens": 150
  },
  "auth": {
    "enabled": false,
    "password": "",
    "mode": "command",
    "debugWindows": false,
    "gui": {
      "titleMatch": ["login", "register", "authme"],
      "slotMap": {},
      "clickDelayMs": 500
    }
  },
  "greeting": true,
  "autoReconnect": true,
  "behaviorMode": "idle",
  "guardrails": true,
  "mcp": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 5400
  },
  "action": {
    "retryDelay": 5000
  },
  "gui": {
    "debugWindows": false,
    "profiles": {
      "shop": {
        "titleMatch": ["sell", "shop"],
        "open": { "via": "chat", "command": "/sell" },
        "clickDelayMs": 400,
        "actions": {
          "sell": {
            "steps": [
              { "clickItem": { "name": "dirt" }, "shift": true },
              { "clickItem": { "customName": "sell" } }
            ]
          }
        }
      },
      "spawner": {
        "titleMatch": ["spawner"],
        "open": { "via": "rightClickBlock", "block": "spawner" },
        "clickDelayMs": 400,
        "actions": {
          "pickup": {
            "steps": [
              { "clickItem": { "customName": "drop all" } }
            ]
          }
        }
      }
    }
  }
}